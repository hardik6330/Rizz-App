<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The floating "Analyze profile" bubble drawn over the supported apps. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <application>
    <!--
      Screen reader for the supported apps. Declares BIND_ACCESSIBILITY_SERVICE so
      only the system can bind it. `packageNames` in the config restricts events to
      those apps, so the service stays cold everywhere else — that is both the
      battery story and the compliance story.
    -->
    <service
      android:name="expo.modules.profilecapture.RizzAccessibilityService"
      android:exported="false"
      android:label="@string/rizz_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/rizz_accessibility_config" />
    </service>
  </application>
</manifest>
