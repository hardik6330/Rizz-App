<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="rizz_accessibility_label">RizzCoach Analyzer</string>
  <string name="rizz_accessibility_summary">Shows an ✨ button on dating profiles and in chats.</string>
  <!--
    This is what the user reads in Settings before enabling, and what Play review
    reads. Keep it truthful and specific: naming the apps, saying it acts only on an
    explicit tap, and that nothing is read or sent in the background. If the
    behaviour changes, this string changes first.
  -->
  <string name="rizz_accessibility_description">Lets RizzCoach recognise when you are on a profile or an open chat in Instagram, Tinder, Bumble, Hinge or Facebook, or an open chat in WhatsApp, Snapchat or Telegram, so it can offer an ✨ button.\n\nOn a profile, tapping ✨ captures that one screen for a report. In a chat, tapping ✨ reads the visible conversation so it can suggest a reply and copy it to your clipboard. In WhatsApp, Snapchat and Telegram only the chat reply is offered — no profile is captured there.\n\nRizzCoach only reads the screen of those apps, and only when you tap ✨. Nothing is read or sent in the background, and screenshots are never saved to your device.</string>
  <string name="rizz_bubble_label">Analyze this profile with RizzCoach</string>
  <string name="rizz_bubble_chat_label">Suggest a reply with RizzCoach</string>
  <!--
    Shown when the bubble is dragged onto ✕. It turns the whole feature off, so the
    toast must say that plainly and say where to turn it back on — otherwise the
    bubble simply never returns and the feature looks broken.
  -->
  <string name="rizz_bubble_disabled">Bubble turned off — re-enable it in RizzCoach</string>
  <!--
    The window manager refused the overlay. Names the permission, because "Display
    over other apps" is what the user has to go and find, and says where — this
    fires while they are inside somebody else's app, not ours.
  -->
  <string name="rizz_overlay_denied">RizzCoach needs \"Display over other apps\" — turn it on in the app</string>

  <!--
    Tone-menu labels, shown UNDER each emoji rather than only as a
    contentDescription. 🔮 / 🔥 / 🎭 are not self-explanatory — three unlabelled
    emoji make the user guess, and a wrong guess costs a credit and lands in a
    real conversation. One word each: the menu floats over somebody else's app
    and has to stay small enough not to cover the thread it is reading.
  -->
  <string name="rizz_tone_vibe">Vibe</string>
  <string name="rizz_tone_roast">Roast</string>
  <string name="rizz_tone_comedy">Funny</string>
  <string name="rizz_tone_cancel">Close</string>

  <!-- Inline chat-reply toasts. Kept short — they flash over another app. -->
  <string name="rizz_chat_reading">Reading the chat…</string>
  <string name="rizz_chat_copied">✨ Reply copied — paste &amp; send</string>
  <string name="rizz_chat_failed">Couldn\'t reach the coach — try again</string>
  <string name="rizz_chat_unreadable">Couldn\'t read the conversation</string>
  <string name="rizz_chat_out_of_credits">Out of free replies — open RizzCoach to unlock</string>
  <!-- Under the reply on the card. The clipboard is easily lost to the next copy. -->
  <string name="rizz_chat_tap_to_copy">Tap to copy again</string>
  <string name="rizz_chat_no_key">RizzCoach isn\'t connected yet — open the app once</string>
</resources>
