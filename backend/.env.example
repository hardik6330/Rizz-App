# ── Secrets. NEVER commit real values — this file IS committed. ──────────────
# The whole point of this service: the Gemini key lives in the server env and
# nowhere else. After cutover, delete EXPO_PUBLIC_GEMINI_API_KEY from EAS *and
# revoke it* — a key that is no longer called is still valid in every APK
# already shipped.
GEMINI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# RevenueCat → Project settings → Integrations → Webhooks (Phase 3)
REVENUECAT_WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/rizzcoach

# PEM CA for the DB connection — either a path (local) or the certificate text
# itself (hosted; there is no file to point at, and this file is gitignored).
# Managed MySQL signs with a CA Node does not trust, so leaving this unset gives
# a certificate error rather than a silent downgrade to an unverified peer.
# Aiven/PlanetScale/DO: download it from the provider console. Railway: there is
# nothing to download — dump MySQL's own auto-generated CA off the handshake with
#   openssl s_client -starttls mysql -connect <host>:<port> -showcerts
# See backend/README.md; a path in a hosted env var is ENOENT at boot and 500s
# every route.
DATABASE_CA=

# ── Config ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Global kill switch. false => every /ai/* returns 503 and clients serve mock seeds.
AI_ENABLED=true

# Optional: route Gemini through Cloudflare AI Gateway for retries + cost logging.
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gw>/google-ai-studio
