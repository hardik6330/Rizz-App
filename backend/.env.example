# ── Secrets. NEVER commit real values — this file IS committed. ──────────────
# The whole point of this service: the Gemini key lives in the server env and
# nowhere else. After cutover, delete EXPO_PUBLIC_GEMINI_API_KEY from EAS *and
# revoke it* — a key that is no longer called is still valid in every APK
# already shipped.
GEMINI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# RevenueCat → Project settings → Integrations → Webhooks (Phase 3)
REVENUECAT_WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/rizzcoach

# OPTIONAL — leave unset. The Railway CA is bundled in src/db/railway-ca.ts, so
# TLS verifies with no configuration. A certificate is not a secret: it carries a
# public key and lets you VERIFY the database, never connect to it. The password
# in DATABASE_URL above is the secret.
#
# Set this only to point at a different provider, or if Railway's MySQL service
# is recreated and mints a fresh CA. Either the PEM text or a path to it:
#   openssl s_client -starttls mysql -connect <host>:<port> -showcerts
# (the CA is the LAST certificate in the chain). Never set it to disable
# verification — see src/db/client.ts.
# DATABASE_CA=

# ── Config ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Global kill switch, defaults to true — leave it unset. Set AI_ENABLED=false to
# make every /ai/* return 503; clients then serve their mock seeds instead of
# breaking, which is why those seeds stay in the bundle. This is the lever to
# pull when the Gemini bill runs away or the model starts misbehaving.
# AI_ENABLED=false

# Optional: route Gemini through Cloudflare AI Gateway for retries + cost logging.
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gw>/google-ai-studio
