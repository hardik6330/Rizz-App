# ── Secrets. NEVER commit real values — this file IS committed. ──────────────
# The whole point of this service: the Gemini key lives in the server env and
# nowhere else. After cutover, delete EXPO_PUBLIC_GEMINI_API_KEY from EAS *and
# revoke it* — a key that is no longer called is still valid in every APK
# already shipped.
GEMINI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# ── RevenueCat. BOTH are REQUIRED when NODE_ENV=production — env.ts refuses to
# boot without them, on purpose. Unset, the server believes the client's Pro
# claim and cancellations never arrive: a subscription business that gives
# itself away silently is worse than one that is down.

# Secret API key — RevenueCat → Project settings → API keys → Secret (sk_…).
# Server only. NEVER the goog_/appl_ public SDK keys the app ships.
REVENUECAT_SECRET_KEY=

# RevenueCat → Project settings → Integrations → Webhooks.
# Set the URL to https://<host>/v1/webhooks/revenuecat and prefer the HMAC
# signing option; the static Authorization header also works.
REVENUECAT_WEBHOOK_SECRET=

# ── Email (OTP codes) ────────────────────────────────────────────────────────
# HOST, USER and PASS are REQUIRED when NODE_ENV=production. Signup will not
# complete without a mailed code, and a code is also the only way back into an
# account whose password was forgotten — so a production instance with no mailer
# is a signup screen that never succeeds. env.ts refuses to boot instead.
#
# ALL THREE OR NONE, in every environment. Two out of three is a boot failure on
# purpose: a host with no password looks configured, so the server would come up
# claiming a working mailer and fail at the first signup instead.
#
# Leave all three BLANK in development: the code is written to the log instead of
# sent, which is what makes the whole flow testable with no mail server. Look for
# the `mail.disabled` line. (A blank value is treated as unset — see
# `blankIsUnset` in env.ts. It was not always, and an empty line used to be a
# boot failure naming a variable you were told to leave alone.)
#
#              SMTP_HOST                      SMTP_PORT  SMTP_USER
#   Gmail      smtp.gmail.com                 465        you@gmail.com
#   Brevo      smtp-relay.brevo.com           587        <your login>
#   Mailgun    smtp.mailgun.org               465        postmaster@<domain>
#   SES        email-smtp.<region>.amazonaws.com  465    <IAM SMTP key>
SMTP_HOST=

# Your email address on Gmail and Brevo. On SES this is an IAM SMTP key, not an
# address — set MAIL_FROM explicitly there.
SMTP_USER=

# GMAIL: this must be a 16-character App Password, NOT your account password —
# Google blocks the real one over SMTP and always will. Turn on 2-Step
# Verification first, then: Google Account → Security → App passwords.
SMTP_PASS=

# 465 = TLS from the first byte. 587 = STARTTLS. Both encrypt; the port picks the
# mode automatically, so just use whichever your provider documents. Defaults to
# 465, so leave it blank unless yours says otherwise. Never 25 — unencrypted, and
# this connection carries SMTP_PASS on every send.
# SMTP_PORT=465

# OPTIONAL — blank sends as SMTP_USER, which is what you want on Gmail (it
# rewrites any other From to the authenticated address anyway), Brevo and
# Mailgun. Set it on SES, where SMTP_USER is a key rather than an address.
# Whatever you put here must be an address the account may send as, or every
# message bounces and signup fails at the code step.
#   MAIL_FROM=RizzCoach <no-reply@rizzcoach.app>
MAIL_FROM=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/rizzcoach

# OPTIONAL — leave unset. The Railway CA is bundled in src/db/railway-ca.ts, so
# TLS verifies with no configuration. A certificate is not a secret: it carries a
# public key and lets you VERIFY the database, never connect to it. The password
# in DATABASE_URL above is the secret.
#
# Set this only to point at a different provider, or if Railway's MySQL service
# is recreated and mints a fresh CA. Either the PEM text or a path to it:
#   openssl s_client -starttls mysql -connect <host>:<port> -showcerts
# (the CA is the LAST certificate in the chain). Never set it to disable
# verification — see src/db/client.ts.
# DATABASE_CA=

# ── Config ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Global kill switch, defaults to true — leave it unset. Set AI_ENABLED=false to
# make every /ai/* return 503; clients then serve their mock seeds instead of
# breaking, which is why those seeds stay in the bundle. This is the lever to
# pull when the Gemini bill runs away or the model starts misbehaving.
# AI_ENABLED=false

EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_mock_key
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_mock_key


# Optional: route Gemini through Cloudflare AI Gateway for retries + cost logging.
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gw>/google-ai-studio
