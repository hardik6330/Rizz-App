# EAS regenerates the native projects from app.json (CNG) on every build.
# Uploading the local prebuild output ships stale native code and a huge archive.
/android
/ios

node_modules
.expo
dist
web-build

# Same as .gitignore: local module build output is regenerated by the EAS build
# itself. Uploading it inflates the archive for no benefit. `/android` and `/ios`
# above cover the app's own prebuild; this covers modules/.
modules/**/build
__MACOSX
