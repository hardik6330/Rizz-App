{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,

  "installCommand": "cd backend && npm ci --include=dev",
  "buildCommand": "mkdir -p public && cd backend && npm run build:vercel",
  "outputDirectory": "public",

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 512
    }
  }
}
