{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "npm ci --prefix backend",
  "buildCommand": "npm run build:vercel --prefix backend",

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 512
    }
  }
}
