{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "cd backend && npm ci",
  "buildCommand": "cd backend && npm run build:vercel",

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 512
    }
  }
}
