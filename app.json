{
  "expo": {
    "name": "RizzCoach",
    "slug": "rizzcoach",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icons/icon.png",
    "scheme": "rizzcoach",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A12",
    "ios": {
      "bundleIdentifier": "com.rizzcoach.chat",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": false,
        "NSSupportsLiveActivitiesFrequentUpdates": false
      }
    },
    "android": {
      "package": "com.rizzcoach.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A12",
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "backgroundImage": "./assets/icons/android-icon-background.png",
        "monochromeImage": "./assets/icons/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A12",
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 150,
          "dark": { "backgroundColor": "#0A0A12" }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RizzCoach reads the chat screenshots you pick so it can craft replies. Nothing is uploaded without your say-so."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "703bba8d-5847-4fd6-8ccd-201540b75983"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "huggingfffce",
    "updates": {
      "url": "https://u.expo.dev/703bba8d-5847-4fd6-8ccd-201540b75983"
    }
  }
}
